{
  "name": "nyvei",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "rides": "tsx pipeline/rides.ts",
    "roads": "tsx pipeline/roads.ts",
    "match": "tsx pipeline/match.ts",
    "writeback": "tsx pipeline/writeback.ts",
    "dev": "vite web",
    "build": "tsc --noEmit -p web && vite build web",
    "pages": "wrangler pages deploy web/dist --project-name nyvei",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "flatbush": "^4.4.0",
    "maplibre-gl": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  }
}
